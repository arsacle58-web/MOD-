{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "arsenal:flash",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/arsenal/particles/flash"
			}
		},
		"curves": {
			"variable.size_age": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.8, 1, 0, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.sizeg=0.4;variable.offset_x=0;variable.offset_y=0;variable.offset_z=0;variable.num=5;variable.min_speed=3;variable.max_speed=20;variable.dir=5;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "variable.num"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["variable.offset_x", "variable.offset_y", "variable.offset_z"],
				"direction": ["math.random(-variable.dir, variable.dir)", 12, "math.random(-variable.dir, variable.dir)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.1, 0.3)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(variable.min_speed, variable.max_speed)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 6
			},
			"minecraft:particle_appearance_billboard": {
				"size": [ "(0.3*v.particle_random_2+0.02) / (v.particle_age+0.03) * variable.size_age * variable.sizeg", "(0.3*v.particle_random_2+0.02) / (v.particle_age+0.03) * variable.size_age * variable.sizeg"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age/variable.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.15": "#FFFFE700",
						"0.23": "#FFFF7A00",
						"0.3": "#FFFF0000"
					}
				}
			}
		}
	}
}